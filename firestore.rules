rules_version = '2';
// Regras do duelo online. Cole em: Firebase Console → Firestore Database → Regras → Publicar.
// - Cada sala de duelo tem um código de 8 caracteres (só quem tem o código encontra a sala).
// - Cada pessoa só escreve o PRÓPRIO placar (documento com o id do seu login anônimo).
// - O placar só tem nome, avatar, plano, data de início e as datas em que treinou.
service cloud.firestore {
  match /databases/{database}/documents {
    match /duelos/{sala} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && sala.matches('^[A-Z2-9]{8}$')
        && request.resource.data.keys().hasOnly(['criadoEm', 'criadoPor'])
        && request.resource.data.criadoPor == request.auth.uid;

      match /jogadores/{uid} {
        allow read: if request.auth != null
          && exists(/databases/$(database)/documents/duelos/$(sala));
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && exists(/databases/$(database)/documents/duelos/$(sala))
          && request.resource.data.keys().hasOnly(['nome', 'emoji', 'personagem', 'plano', 'inicio', 'feitos', 'cardios', 'atualizadoEm'])
          && request.resource.data.nome is string && request.resource.data.nome.size() > 0 && request.resource.data.nome.size() <= 30
          && request.resource.data.plano in ['pedro', 'feminino']
          && request.resource.data.inicio is string && request.resource.data.inicio.size() == 10
          && request.resource.data.feitos is list && request.resource.data.feitos.size() <= 500
          && request.resource.data.cardios is list && request.resource.data.cardios.size() <= 500;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
